# Service systemd du site SC+ Talent & Sports (Django + gunicorn sur 127.0.0.1:8240)
[Unit]
Description=SC+ Talent & Sports (site + espace admin)
After=network.target

[Service]
User=sctalents
Group=sctalents
WorkingDirectory=/opt/sctalents/app
EnvironmentFile=/opt/sctalents/.env
# gthread : les vidéos envoyées sont allégées dans un fil à part sans bloquer le site
ExecStart=/opt/sctalents/venv/bin/gunicorn config.wsgi:application \
    --bind 127.0.0.1:8240 --workers 2 --worker-class gthread --threads 4 \
    --timeout 600 --access-logfile - --error-logfile -
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
